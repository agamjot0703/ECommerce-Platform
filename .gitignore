# ====================================================================
# Git Ignore Configuration for C++ Qt Projects
# Prevents temporary build artifacts and IDE cache from being pushed
# ====================================================================

# Compiled Executables, Libraries, and Object Files
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.o
*.obj

# Qt Meta-Object Compiler (MOC) and Generated Files
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
.qmake.stash
Makefile
Makefile.Debug
Makefile.Release
object_script.*

# Build Output Directories
release/
debug/
build/
bin/
build-*/

# Qt Creator Configuration & Cache
*.user
*.user.*
.qtcreator/
.qtc_clangd/

# Visual Studio & VS Code Cache
.vscode/
.vs/
.idea/
*.suo
*.userosv

# Windows System Files
Thumbs.db
Desktop.ini
.DS_Store

# Temporary Exported Files
Receipt_*.txt
